#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost/'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
cookie.domain = ''
cookie.secure = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = ci4
database.default.username = ci4_user
database.default.password = password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =
# ENCRYPTION_KEY =

#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

email.protocol = mail
email.fromEmail =
email.fromName =
email.recipients =
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 25
email.SMTPAuthMethod = login
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# Leave unset to use Config\Session default WRITEPATH . 'session'
# session.savePath =
session.cookieName = 'ci_session'

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

security.tokenName = csrf_test_name
security.cookieName = csrf_cookie_name

#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------

cache.memcached.host = 127.0.0.1
cache.memcached.port = 11211
cache.redis.host = 127.0.0.1
cache.redis.password =
cache.redis.port = 6379

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
